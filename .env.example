# Copy to .env and fill in. Never commit .env.

# Used by the triage layer (anvil/triage/engine.py). If unset, triage falls back
# to a deterministic offline heuristic so the pipeline still runs end-to-end.
ANTHROPIC_API_KEY=

# Secret used to sign/verify authorization records (controller/scope_guard.py).
# Rotating this invalidates every previously signed authorization.
ANVIL_AUTH_SIGNING_KEY=change-me-to-a-long-random-value
